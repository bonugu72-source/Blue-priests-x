rules_version = '2';
// 푸른사제들 — GitHub Pages용 Firestore 보안 규칙
// owners/{pid}            : 캐릭터 주인 키 (아무도 읽을 수 없음, 처음 한 번만 생성)
// owners/{pid}/devices/{u}: 키를 아는 기기만 연결 가능
// players/{pid}           : 친구 목록용 공개 프로필 (로그인하면 읽기, 연결된 기기만 쓰기)
// saves/{pid}             : 클라우드 저장 (연결된 기기만)
// links/{code}            : 기기 연결용 8자리 코드 (10분짜리, 한 번 쓰면 삭제)
// gifts/{to}/inbox/{id}   : 친구에게 보낸 코인 선물 (보낸 사람이 만들고, 받는 사람만 읽고 지움)
// uids·rooms·chatbox      : 친구 채팅 (1:1 · 단체)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function linked(pid) {
      return signedIn() && exists(/databases/$(database)/documents/owners/$(pid)/devices/$(request.auth.uid));
    }
    match /owners/{pid} {
      allow create: if signedIn() && pid.size() <= 40
        && request.resource.data.keys().hasOnly(['key'])
        && request.resource.data.key is string && request.resource.data.key.size() >= 16;
      match /devices/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key == get(/databases/$(database)/documents/owners/$(pid)).data.key;
      }
    }
    match /players/{pid} {
      allow read: if signedIn();
      allow create, update: if linked(pid);
    }
    match /saves/{pid} {
      allow read, create, update: if linked(pid);
    }
    // gifts/{to}/inbox/{id}: 코인 선물 — 연결된 기기가 자기 이름(from)으로만 보내고, 1~100000 정수, 받는 사람만 읽기·삭제
    match /gifts/{to}/inbox/{gid} {
      allow read, delete: if linked(to);
      allow create: if linked(request.resource.data.from)
        && request.resource.data.from != to
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'amount', 'at'])
        && request.resource.data.amount is int
        && request.resource.data.amount >= 1 && request.resource.data.amount <= 100000
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 20
        && request.resource.data.at is int;
    }
    // links/{code}: 기기 연결용 8자리 코드 (연결된 기기만 만들고, 최대 15분 동안만 읽을 수 있음, 쓰고 나면 삭제)
    match /links/{code} {
      allow get: if signedIn() && (resource == null || resource.data.exp > request.time.toMillis());
      allow create: if code.size() == 8
        && linked(request.resource.data.pid)
        && request.resource.data.keys().hasOnly(['pid', 'key', 'exp'])
        && request.resource.data.key == get(/databases/$(database)/documents/owners/$(request.resource.data.pid)).data.key
        && request.resource.data.exp is int
        && request.resource.data.exp <= request.time.toMillis() + 900000;
      allow delete: if signedIn();
    }
    // ===== 친구 채팅 =====
    // uids/{uid}: 이 기기(로그인 uid)가 지금 쓰는 캐릭터 id — 연결된 캐릭터로만 등록, 자기 것만 읽기
    function me() { return get(/databases/$(database)/documents/uids/$(request.auth.uid)).data.pid; }
    match /uids/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pid']) && linked(request.resource.data.pid);
    }
    // rooms/{rid}: 채팅방 (1:1은 d_아이디1_아이디2, 단체는 g_…) — 멤버만 읽고, 최대 10명
    match /rooms/{rid} {
      allow get: if signedIn() && (resource == null || me() in resource.data.members);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type', 'name', 'owner', 'members', 'names', 'at', 'lastAt', 'lastText', 'lastFrom', 'lastName'])
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2 && request.resource.data.members.size() <= 10
        && request.resource.data.owner == me() && me() in request.resource.data.members
        && request.resource.data.names is map && request.resource.data.names.size() <= 20
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && ((request.resource.data.type == 'dm' && request.resource.data.members.size() == 2
              && rid == 'd_' + request.resource.data.members[0] + '_' + request.resource.data.members[1])
          || (request.resource.data.type == 'group' && rid.matches('g_[a-z0-9]{10,40}')));
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'lastAt', 'lastText', 'lastFrom', 'lastName'])
        && request.resource.data.names is map && request.resource.data.names.size() <= 20
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 60
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastAt', 'lastText', 'lastFrom', 'lastName'])
          || request.resource.data.lastFrom == me())
        && (request.resource.data.members == resource.data.members
          || (resource.data.type == 'group' && request.resource.data.members.size() <= 10
              && request.resource.data.members.hasAll(resource.data.members))
          || (resource.data.type == 'group' && resource.data.members.hasAll(request.resource.data.members)
              && !(me() in request.resource.data.members)
              && request.resource.data.members.size() == resource.data.members.size() - 1));
      // rooms/{rid}/msgs/{mid}: 메시지 — 멤버만 읽고, 내 이름으로만 보내기 (고치기·지우기 없음)
      match /msgs/{mid} {
        allow read: if signedIn() && me() in get(/databases/$(database)/documents/rooms/$(rid)).data.members;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['from', 'name', 'text', 'at'])
          && request.resource.data.from == me()
          && me() in getAfter(/databases/$(database)/documents/rooms/$(rid)).data.members
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
          && request.resource.data.name is string && request.resource.data.name.size() <= 12
          && request.resource.data.at is int;
      }
    }
    // chatbox/{pid}/rooms/{rid}: 내가 들어간 채팅방 목록 — 방 멤버가 다른 멤버 목록에 넣어 주고, 주인만 읽고 지우기
    match /chatbox/{pid}/rooms/{rid} {
      allow read, delete: if linked(pid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is int
        && getAfter(/databases/$(database)/documents/rooms/$(rid)).data.members.hasAll([pid, me()]);
    }
  }
}
